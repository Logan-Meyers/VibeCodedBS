# fib_n.bf: reads n and prints the nth Fibonacci number, any size
# fib(0) = 0  fib(1) = 1  fib(14) = 377  fib(100) = 354224848179261915075
#
# input: up to 5 digits (n up to 99999) ending in a newline or EOF
# works with plain 8-bit cells: numbers are kept as decimal digits
# the default 30000-cell tape fits answers up to about 3700 digits
# (n up to about 17000); pass --tape for more
#
# GENERATED by tools/gen_fib_n.py; edit that and regenerate
#
# layout: cells 1 to 5 hold n (least significant digit first)
#         then 8-cell digit groups from cell 16: flag a b carry sum w 0 0
#         a and b are fib(i) and fib(i plus 1), least significant group first

# ---- stage 1: read n (shift each new digit in at the bottom) ----
>>>>>>[-]+                              # keep reading
[-                                      # assume this is the last char
>,                                      # next char
[----------                             # newline check
[-------------------------------------- # char to digit value
<<[-]<[->+<]<[->+<]<[->+<]<[->+<]       # shift n up one decimal place
>>>>>>[-<<<<<<+>>>>>>]                  # new digit at the bottom
<+                                      # read another char
>]
]
<]
# ---- a = 0 and b = 1: group 1 in use ----
>>>>>>>>>>>>>>>>>>+>>+                  # group 1: flag = 1  b = 1
# ---- stage 2: repeat n times: n minus 1 then (a b) = (b a plus b) ----
<<<<<<<<<<<<<<<<<<[-]<<<<<<<[->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<[[-]<[-]+>]<<<<<<<[->>>>>>>+>+<<<<<<<<]>>>>>>>>[-<<<<<<<<+>>>>>>>>]<[[-]<[-]+>]<<<<<<[->>>>>>+>+<<<<<<<]>>>>>>>[-<<<<<<<+>>>>>>>]<[[-]<[-]+>]<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<[[-]<[-]+>]<<<<[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<[[-]<[-]+>] # NZ = 1 if n is not 0
<[[-]>>>[-]+                            # borrow 1
[->+<]>[-<+<<<<<<<<<<[->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]+<[[-]>->-<<]>[-<<<<<<<<<++++++++++>>>>>>>>>]<<<<<<<<<->>>>>>>>>>>] # digit 0: 0 becomes 9 and borrows, else just minus 1
<[->+<]>[-<+<<<<<<<<<[->>>>>>>+>+<<<<<<<<]>>>>>>>>[-<<<<<<<<+>>>>>>>>]+<[[-]>->-<<]>[-<<<<<<<<++++++++++>>>>>>>>]<<<<<<<<->>>>>>>>>>] # digit 1: 0 becomes 9 and borrows, else just minus 1
<[->+<]>[-<+<<<<<<<<[->>>>>>+>+<<<<<<<]>>>>>>>[-<<<<<<<+>>>>>>>]+<[[-]>->-<<]>[-<<<<<<<++++++++++>>>>>>>]<<<<<<<->>>>>>>>>] # digit 2: 0 becomes 9 and borrows, else just minus 1
<[->+<]>[-<+<<<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]+<[[-]>->-<<]>[-<<<<<<++++++++++>>>>>>]<<<<<<->>>>>>>>] # digit 3: 0 becomes 9 and borrows, else just minus 1
<[->+<]>[-<+<<<<<<[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]+<[[-]>->-<<]>[-<<<<<++++++++++>>>>>]<<<<<->>>>>>>] # digit 4: 0 becomes 9 and borrows, else just minus 1
>>>>
>>>>>>>>                                # to group 1
[                                       # for each group in use
>[->>>+<<<]>[-<+>>>+<<]>[->+<]          # sum = a plus b plus carry and a = b
>>++++++++++                            # w counts down to the next wrap
<[-<<+>>>->+<[>-]>[-<++++++++++<<<[-]>>>>>>>>>+<<<<<>]<<<] # b = sum mod 10 and carry into the next group
>[-]<<<<<>>>>>>>>]                      # next group
>>>[-<<<+>>+>]<<<                       # carry out of the top: switch on a new group
<<<<<<<<[<<<<<<<<]                      # back to group 0
<<<<<<<<[-]<<<<<<<[->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<[[-]<[-]+>]<<<<<<<[->>>>>>>+>+<<<<<<<<]>>>>>>>>[-<<<<<<<<+>>>>>>>>]<[[-]<[-]+>]<<<<<<[->>>>>>+>+<<<<<<<]>>>>>>>[-<<<<<<<+>>>>>>>]<[[-]<[-]+>]<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<[[-]<[-]+>]<<<<[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<[[-]<[-]+>] # NZ = 1 if n is not 0
<]
# BREAKPOINT a = fib(n) is ready; groups from cell 24 hold its digits
# ---- stage 3: print a from the top group down, skipping leading zeros ----
>>>>>>>>>>>>>>>>[>>>>>>>>]<<<<<<<<      # to the top group in use
[                                       # for each group going down
>[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<[[-]<[-]+>] # started = started or a is not 0
<[->>+<+<]>[-<+>]>[-<<<<<++++++++++++++++++++++++++++++++++++++++++++++++.>>>>>] # if started: print the digit
<<[-<<<<<<<<+>>>>>>>>]                  # hand started down
<<<<<<<<<<<<]
>>>>>[-]+<[[-]>-<]>[->++++++++++++++++++++++++++++++++++++++++++++++++.[-]<] # nothing printed: fib(0) is 0
>[-]++++++++++.                         # newline
